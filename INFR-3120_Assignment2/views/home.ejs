<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel='stylesheet' href='/Content/app.css' />
    <script src="/Script/app.js"></script>

    <!-- Links for Nav component-->
    <link rel="stylesheet" href="/bootstrap/dist/css/bootstrap.min.css">
    <script src="/bootstrap/dist/js/bootstrap.min.js"></script>

    <!-- Link for icons -->
    <link rel="stylesheet" href="/@fortawesome/fontawesome-free/css/all.min.css">

  </head>
  <body>
    <header>
      <!-- Nav bar by bootstrap -->
      <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
          <a class="navbar-brand" href="/">My Portfolio</a>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
              <!-- Code Sections for all site pages -->
              <li class="nav-item">
                <% if(title=="Home Page") {%>
                  <a class="nav-link active" aria-current="page" href="/home"><i class="fa-solid fa-house"></i> Home Page</a>
                <% } else { %>
                  <a class="nav-link" aria-current="page" href="/home"><i class="fa-solid fa-house"></i> Home Page</a>
                <% } %>
              </li>
              <li class="nav-item">
                <% if(title=="Contact Me Page") {%>
                  <a class="nav-link active" aria-current="page" href="/contactme"><i class="fa-solid fa-phone"></i> Contact Me</a>
                <% } else { %>
                  <a class="nav-link" aria-current="page" href="/contactme"><i class="fa-solid fa-phone"></i> Contact Me</a>
                <% } %>
              </li>
              <li class="nav-item">
                <% if(title=="Projects Page") {%>
                  <a class="nav-link active" aria-current="page" href="/projects"><i class="fa-solid fa-diagram-project"></i> Projects</a>
                <% } else { %>
                  <a class="nav-link" aria-current="page" href="/projects"><i class="fa-solid fa-diagram-project"></i> Projects</a>
                <% } %>
              </li>
              <li class="nav-item">
                <% if(title=="About Me Page") {%>
                  <a class="nav-link active" aria-current="page" href="/aboutme"><i class="fa-solid fa-user"></i> About Me</a>
                <% } else { %>
                  <a class="nav-link" aria-current="page" href="/aboutme"><i class="fa-solid fa-user"></i> About Me</a>
                <% } %>
              </li>
            </ul>
          </div>
        </div>
      </nav>
    </header>
    <h1><%= title %></h1>
    <p>Welcome to <%= title %></p>
    <p>Hell</p>
  </body>
</html>
